#!/bin/bash
#SBATCH --job-name=bc-localize
#SBATCH --output=./out/%x-%a.out
#SBATCH --error=./err/%x-%a.err
#SBATCH --time=1-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=4G
#SBATCH --partition=cpu_lorentz        # SITE: ALICE private partition, 7-day cap
#SBATCH --account=cpu_lorentz          # SITE: ALICE rejects cpu_lorentz without this
#SBATCH --mail-type=NONE
#SBATCH --array=0-11
#
# Butadiene: locate what loop transport encircles, across the active-space ladder.
# docs/todo.md §9; method in notebooks/locating_intersections.ipynb.
#
#   cd slurm && sbatch localize.job
#   # then, per rung, once its three tasks are done:
#   python examples/run_localization.py butadiene --cas 6 6 --merge
#
# Why: the state-specific/state-averaged offset has been *measured* only at CAS(2,2) for
# butadiene (rho = 0.5385 +/- 0.0843 against the gap scan's 0.2121). One rung is an
# observation; a ladder is a result, and the rungs are where the two methods disagree.
#
# One centre per task, twelve tasks: bisections about different centres share no state, and
# a rung run in series is 6-21 h here. Split, the longest centre sets the wall clock.
#
# Sizing, measured on node022 rather than extrapolated: a state-specific point costs 2.7x
# what it costs on the laptop (CAS(2,2) 9.34 s against 3.65; CAS(12,12) 349 s against 127),
# and the laptop's CAS(2,2) localization spent 2.0 h over three centres. That puts a centre
# at 2-7 h across these four rungs. A day is asked, because a probe that lands *on* the
# degeneracy costs several times one that does not.
#
# Memory: 4G against a measured peak of 593 MB at CAS(12,12), the largest rung in the
# project. cpu_lorentz is memory-saturated far more often than CPU-saturated (DefMemPerCPU
# is 4027 MB, so wide jobs reserve hundreds of GB), and an over-request here blocks both
# this account's other work and other people's.

set -euo pipefail

# Expensive rungs first, so the tail of the array is the cheap one.
NE_VALUES=(4 10 8 6)
NCAS_VALUES=(4 10 8 6)
N_CENTRES=3
RUNG=$((SLURM_ARRAY_TASK_ID / N_CENTRES))
CENTRE=$((SLURM_ARRAY_TASK_ID % N_CENTRES))
NE=${NE_VALUES[$RUNG]}
NCAS=${NCAS_VALUES[$RUNG]}

cd ..
ml purge
ml load ALICE/default                            # SITE: ALICE module stack
ml load Python/3.11.5-GCCcore-13.2.0             # SITE: the module the venv was built on
source "$HOME/git_repos/BerryCASSCF/.venv/bin/activate"

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
export MKL_NUM_THREADS="${OMP_NUM_THREADS}"
export OPENBLAS_NUM_THREADS="${OMP_NUM_THREADS}"

echo "host=$(hostname) job=${SLURM_JOB_ID:-none}_${SLURM_ARRAY_TASK_ID:-none} threads=${OMP_NUM_THREADS}"
echo "commit=$(git rev-parse --short HEAD)"
echo "python -u examples/run_localization.py butadiene --cas $NE $NCAS --only-centre $CENTRE"
python -u examples/run_localization.py butadiene --cas "$NE" "$NCAS" --only-centre "$CENTRE"
